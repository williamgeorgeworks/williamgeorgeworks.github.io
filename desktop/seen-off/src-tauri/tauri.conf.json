{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seen Off",
  "version": "0.1.0",
  "identifier": "uk.co.williamgeorgeworks.seenoff",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Seen Off",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#16244a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "Game",
    "publisher": "William George Works",
    "copyright": "William George Works",
    "shortDescription": "A card game of doubtful magic",
    "longDescription": "Seen Off: pick a Quill, pick a cat, build a deck and see off whatever is lurking on a day out in Blackpool.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../web/fonts/OFL-Anton.txt": "licences/OFL-Anton.txt",
      "../web/fonts/LICENSE-PermanentMarker-Apache-2.0.txt": "licences/LICENSE-PermanentMarker-Apache-2.0.txt",
      "../THIRD_PARTY_NOTICES.md": "licences/THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
